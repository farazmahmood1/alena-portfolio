{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/branding", "destination": "/services/branding-design", "permanent": true },
    { "source": "/shopify-brand-development", "destination": "/services/shopify-ecommerce", "permanent": true },
    { "source": "/custom-website-app-development", "destination": "/services/web-development", "permanent": true },
    { "source": "/ai-automation", "destination": "/services/ai-automation", "permanent": true },
    { "source": "/work", "destination": "/portfolio/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(wp-content|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/site-config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(robots|llms).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
