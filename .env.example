# Codilated — environment variables. Copy to .env (never commit real values).
#
# The website itself is static HTML; these are used by
#   - server/            the contact-form API (Express + MongoDB), and
#   - scripts/write-site-config.mjs, which bakes the public front-end settings
#     into assets/site-config.js at deploy time.

# ---- Contact API (server/) --------------------------------------------------
MONGODB_URI=
PORT=3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address for notification emails (defaults to SMTP_USER).
SMTP_FROM=
# Where new enquiries are emailed.
CONTACT_NOTIFY_EMAIL=
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=https://codilated.com,https://www.codilated.com
# Reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=1
SITE_URL=https://codilated.com

# ---- Front end (scripts/write-site-config.mjs) -------------------------------
# GA4 measurement ID (G-XXXXXXX). Leave empty to load no analytics at all.
VITE_GA_MEASUREMENT_ID=
# Public origin of the contact API, e.g. https://api.codilated.com.
# Leave empty if the API is served from the site's own origin under /api/.
API_BASE=
